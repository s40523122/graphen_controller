<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>graphen_choreographer</name>
  <version>0.0.0</version>
  <description>Multi-track keyframe choreographies (composed motions) as a graphen_locomotion algorithm plugin, with an offline checker. No rclcpp dependency.</description>
  <maintainer email="riverji@graphen.ai">jin</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>graphen_locomotion</depend>
  <depend>pluginlib</depend>
  <depend>urdfdom</depend>
  <depend>yaml-cpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
