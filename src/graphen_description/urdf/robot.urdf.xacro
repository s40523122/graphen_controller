<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

  <!-- IMU：use_mock_imu:=true 時使用 mock 的 imu/raw_data（原本的模擬方式），
       false 時使用實機 FSS-IMU16460-C（imu16460_hardware） -->
  <xacro:arg name="use_mock_imu" default="true"/>
  <xacro:arg name="imu_port" default="/dev/ttyTHS1"/>
  <xacro:arg name="imu_baudrate" default="921600"/>
  <!-- IMU 相對 base_link 的安裝位置 -->
  <xacro:arg name="imu_xyz" default="0 0 0.1"/>
  <xacro:arg name="imu_rpy" default="0 0 0"/>

  <!-- 1. 簡化版的機器人物理連桿與關節定義 -->
  <link name="world"/>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.2 0.2 0.2"/>
      </geometry>
    </visual>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <link name="imu_link"/>

  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="$(arg imu_xyz)" rpy="$(arg imu_rpy)"/>
  </joint>

  <!-- 手臂關節 joint_arm1 -->
  <link name="arm_link">
    <visual>
      <geometry>
        <cylinder length="0.5" radius="0.05"/>
      </geometry>
    </visual>
  </link>

  <joint name="joint_arm1" type="revolute">
    <parent link="base_link"/>
    <child link="arm_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- 夾爪關節 joint_gripper1 -->
  <link name="gripper_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.1"/>
      </geometry>
    </visual>
  </link>

  <joint name="joint_gripper1" type="prismatic">
    <parent link="arm_link"/>
    <child link="gripper_link"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.1" effort="5.0" velocity="0.5"/>
  </joint>


  <!-- ==================================================== -->
  <!-- 2. ros2_control 硬體配置標籤 (核心部分)             -->
  <!-- ==================================================== -->
  <ros2_control name="MyRobotHardwareSystem" type="system">
    <hardware>
      <!-- 這裡示範使用 ROS 2 官方的 Mock Hardware (模擬器) -->
      <!-- 未來替換成您自己的實體硬體 Plugin，例如 my_hardware/AsyncSensorPlugin -->
      <plugin>mock_components/GenericSystem</plugin>
      <param name="calculate_dynamics">true</param>
      <!-- 為 sensor 產生同名 command interface，可用 topic 寫入模擬資料 -->
      <param name="mock_sensor_commands">true</param>
    </hardware>

    <!-- 定義 joint_arm1 提供的介面 -->
    <joint name="joint_arm1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <!-- 定義 joint_gripper1 提供的介面 -->
    <joint name="joint_gripper1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <!-- 模擬 sensor：imu/raw_data（只在 use_mock_imu:=true 時存在） -->
    <xacro:if value="$(arg use_mock_imu)">
      <sensor name="imu">
        <state_interface name="raw_data">
          <param name="initial_value">1.23</param>
        </state_interface>
      </sensor>
    </xacro:if>
  </ros2_control>

  <!-- 實機 IMU：獨立的 sensor 硬體元件，與上面的 mock system 由同一個 controller_manager 管理 -->
  <xacro:unless value="$(arg use_mock_imu)">
    <xacro:include filename="$(find imu16460_hardware)/urdf/imu16460.ros2_control.xacro"/>
    <xacro:imu16460_ros2_control name="imu16460" sensor_name="imu_sensor"
                                 port="$(arg imu_port)" baudrate="$(arg imu_baudrate)"/>
  </xacro:unless>

</robot>
