<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- ═══════════════════════════════════════════
       右手 ros2_control 硬體介面
  ════════════════════════════════════════════ -->
  <!-- serial_port / hand_id / baudrate 僅在實機模式使用；預設值沿用原本寫死的設定 -->
  <xacro:macro name="right_hand_ros2_control"
    params="use_fake_hardware prefix:='' serial_port:=/dev/ttyUSB0 hand_id:=1 baudrate:=115200">

    <ros2_control name="${prefix}right_hand_hardware" type="system">
      <hardware>
        <xacro:if value="${use_fake_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_fake_hardware}">
          <plugin>dexterous_hand_hardware/DexterousHandHardware</plugin>
          <param name="serial_port">${serial_port}</param>
          <param name="hand_id">${hand_id}</param>
          <param name="baudrate">${baudrate}</param>
        </xacro:unless>
      </hardware>

      <!-- 拇指 -->
      <joint name="${prefix}right_thumb_yaw_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="current"/>
        <state_interface name="error"/>
        <state_interface name="status"/>
        <state_interface name="temperature"/>
      </joint>
      <joint name="${prefix}right_thumb_mcp_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="current"/>
        <state_interface name="error"/>
        <state_interface name="status"/>
        <state_interface name="temperature"/>
      </joint>
      <joint name="${prefix}right_thumb_dip_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="current"/>
        <state_interface name="error"/>
        <state_interface name="status"/>
        <state_interface name="temperature"/>
      </joint>

      <!-- 食指 -->
      <joint name="${prefix}right_index_yaw_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="current"/>
        <state_interface name="error"/>
        <state_interface name="status"/>
        <state_interface name="temperature"/>
      </joint>
      <joint name="${prefix}right_index_mcp_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="current"/>
        <state_interface name="error"/>
        <state_interface name="status"/>
        <state_interface name="temperature"/>
      </joint>
      <joint name="${prefix}right_index_pip_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="current"/>
        <state_interface name="error"/>
        <state_interface name="status"/>
        <state_interface name="temperature"/>
      </joint>

      <!-- 中指 -->
      <joint name="${prefix}right_middle_yaw_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="current"/>
        <state_interface name="error"/>
        <state_interface name="status"/>
        <state_interface name="temperature"/>
      </joint>
      <joint name="${prefix}right_middle_mcp_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="current"/>
        <state_interface name="error"/>
        <state_interface name="status"/>
        <state_interface name="temperature"/>
      </joint>
      <joint name="${prefix}right_middle_pip_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="current"/>
        <state_interface name="error"/>
        <state_interface name="status"/>
        <state_interface name="temperature"/>
      </joint>

      <!-- 無名指 -->
      <joint name="${prefix}right_ring_mcp_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="current"/>
        <state_interface name="error"/>
        <state_interface name="status"/>
        <state_interface name="temperature"/>
      </joint>
      <joint name="${prefix}right_ring_pip_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="current"/>
        <state_interface name="error"/>
        <state_interface name="status"/>
        <state_interface name="temperature"/>
      </joint>

      <!-- 小指 -->
      <joint name="${prefix}right_pinky_mcp_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="current"/>
        <state_interface name="error"/>
        <state_interface name="status"/>
        <state_interface name="temperature"/>
      </joint>
      <joint name="${prefix}right_pinky_pip_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="current"/>
        <state_interface name="error"/>
        <state_interface name="status"/>
        <state_interface name="temperature"/>
      </joint>

      <!-- 🌟 右手觸覺感測器 (依照 C++ 陣列 0~7 的順序排列) -->
      <!-- [0] 小拇指 -->
      <sensor name="${prefix}right_pinky_tactile">
        <state_interface name="tactile_normal"/>
        <state_interface name="tactile_tangent"/>
        <state_interface name="tactile_direction"/>
      </sensor>
      <!-- [1] 無名指 -->
      <sensor name="${prefix}right_ring_tactile">
        <state_interface name="tactile_normal"/>
        <state_interface name="tactile_tangent"/>
        <state_interface name="tactile_direction"/>
      </sensor>
      <!-- [2] 中指 -->
      <sensor name="${prefix}right_middle_tactile">
        <state_interface name="tactile_normal"/>
        <state_interface name="tactile_tangent"/>
        <state_interface name="tactile_direction"/>
      </sensor>
      <!-- [3] 食指 -->
      <sensor name="${prefix}right_index_tactile">
        <state_interface name="tactile_normal"/>
        <state_interface name="tactile_tangent"/>
        <state_interface name="tactile_direction"/>
      </sensor>
      <!-- [4] 大拇指 -->
      <sensor name="${prefix}right_thumb_tactile">
        <state_interface name="tactile_normal"/>
        <state_interface name="tactile_tangent"/>
        <state_interface name="tactile_direction"/>
      </sensor>
      <!-- [5] 掌心右 -->
      <sensor name="${prefix}right_palm_tactile_right">
        <state_interface name="tactile_normal"/>
        <state_interface name="tactile_tangent"/>
        <state_interface name="tactile_direction"/>
      </sensor>
      <!-- [6] 掌心中 -->
      <sensor name="${prefix}right_palm_tactile_middle">
        <state_interface name="tactile_normal"/>
        <state_interface name="tactile_tangent"/>
        <state_interface name="tactile_direction"/>
      </sensor>
      <!-- [7] 掌心左 -->
      <sensor name="${prefix}right_palm_tactile_left">
        <state_interface name="tactile_normal"/>
        <state_interface name="tactile_tangent"/>
        <state_interface name="tactile_direction"/>
      </sensor>
    </ros2_control>
  
  </xacro:macro>

  <!-- ═══════════════════════════════════════════
       左手 ros2_control 硬體介面
  ════════════════════════════════════════════ -->
  <!-- serial_port / hand_id / baudrate 僅在實機模式使用；預設值沿用原本寫死的設定 -->
