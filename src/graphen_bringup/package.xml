<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>graphen_bringup</name>
  <version>0.0.0</version>
  <description>Launch files and controller configuration for graphen.</description>
  <maintainer email="riverji@graphen.ai">jin</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <!-- hardware:=mujoco / mujoco_pd 時才需要；沒有建置時其他硬體仍可使用 -->
  <exec_depend>graphen_mujoco</exec_depend>
  <!-- robot:= 的模型套件：MJCF 與 config/joint_pd_gains.yaml -->
  <exec_depend>fb70_description</exec_depend>
  <exec_depend>ti5_t170_description</exec_depend>
  <exec_depend>graphen_controllers</exec_depend>
  <!-- 編舞模式（graphen_choreographer/ChoreographerAlgorithm）與 motions/*.choreo.yaml -->
  <exec_depend>graphen_choreographer</exec_depend>
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>imu_sensor_broadcaster</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ti5_170a_graphen</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
