<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>graphen_aiterone_ny_description</name>
  <version>1.0.0</version>
  <description>URDF/xacro, meshes and ros2_control description of the Graphen AiterOne NY humanoid (T170 V2.1 A0 body + dexterous hands).</description>
  <maintainer email="TODO@email.com">TODO</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>dexterous_hand_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- scripts/make_hulls.py、make_mjcf.py（開發工具）；make_mjcf.py 另需 MuJoCo 3.11.0 -->
  <test_depend>python3-numpy</test_depend>
  <test_depend>python3-scipy</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
