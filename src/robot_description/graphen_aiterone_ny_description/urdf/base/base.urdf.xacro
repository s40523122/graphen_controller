<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="t170_base" params="prefix mesh_dir">

    <!-- ===== BASE_S ===== -->
    <link name="${prefix}BASE_S">
      <inertial>
        <!-- 質量取自 ti5_t170_description（graphen_ws） -->
        <origin xyz="0.012912000000000002 0.0 1e-06" rpy="0 0 0"/>
        <mass value="1.59576"/>
        <inertia ixx="0.0022853685610000002" ixy="-6.6967628e-05" ixz="1.8939000000000002e-08"
                 iyy="0.002616810253" iyz="5.8460999999999997e-08" izz="0.0022603466290000004"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/BASE_S.STL"/></geometry>
        <material name="t170_white"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/hulls/BASE_S.STL"/></geometry>
      </collision>
    </link>

    <!-- ===== WAIST_Y ===== -->
    <joint name="${prefix}WAIST_Y" type="revolute">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}BASE_S"/>
      <child  link="${prefix}WAIST_Y_S"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14" upper="3.14" effort="63" velocity="8.06"/>
    </joint>

    <link name="${prefix}WAIST_Y_S">
      <inertial>
        <!-- 質量取自 ti5_t170_description（graphen_ws） -->
        <origin xyz="-0.0018620000000000002 0.006023 0.0" rpy="0 0 0"/>
        <mass value="1.3648900000000002"/>
        <inertia ixx="0.00135736113" ixy="-1.4724409e-05" ixz="1.2329e-08"
                 iyy="0.001535532148" iyz="6.57486e-07" izz="0.001427142563"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/WAIST_Y_S.STL"/></geometry>
        <material name="t170_light_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/hulls/WAIST_Y_S.STL"/></geometry>
      </collision>
    </link>

    <!-- ===== WAIST_R ===== -->
    <joint name="${prefix}WAIST_R" type="revolute">
      <origin xyz="0 0 0.09265" rpy="0 0 0"/>
      <parent link="${prefix}WAIST_Y_S"/>
      <child  link="${prefix}WAIST_R_S"/>
      <axis xyz="1 0 0"/>
      <limit lower="-0.61" upper="0.61" effort="63" velocity="8.06"/>
    </joint>

    <link name="${prefix}WAIST_R_S">
      <inertial>
        <!-- 質量取自 ti5_t170_description（graphen_ws） -->
        <origin xyz="0.01549 -1.2e-05 0.181067" rpy="0 0 0"/>
        <mass value="1.36"/>
        <inertia ixx="0.000774168166278" ixy="-6.4718932e-08" ixz="0.000023014976843"
                 iyy="0.000878785021445" iyz="0.00000010230918" izz="0.000622648967559"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/WAIST_R_S.STL"/></geometry>
        <material name="t170_light_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/hulls/WAIST_R_S.STL"/></geometry>
      </collision>
    </link>

    <!-- ===== WAIST_P ===== -->
    <joint name="${prefix}WAIST_P" type="revolute">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}WAIST_R_S"/>
      <child  link="${prefix}WAIST_P_S"/>
      <axis xyz="0 1 0"/>
      <limit lower="-0.244" upper="0.523" effort="63" velocity="8.06"/>
    </joint>

    <link name="${prefix}WAIST_P_S">
      <inertial>
        <!-- 質量取自 ti5_t170_description（graphen_ws） -->
        <origin xyz="0.011704 0.0 0.0" rpy="0 0 0"/>
        <mass value="6.85"/>
        <inertia ixx="0.00189651073" ixy="-9.3270475e-05" ixz="3.0379999999999996e-09"
                 iyy="0.0015516355660000001" iyz="2.7810000000000002e-09" izz="0.001933221181"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/WAIST_P_S.STL"/></geometry>
        <material name="t170_light_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/hulls/WAIST_P_S.STL"/></geometry>
      </collision>
    </link>

  </xacro:macro>

</robot>
