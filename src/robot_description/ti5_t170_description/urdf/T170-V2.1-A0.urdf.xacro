<?xml version="1.0"?>


<robot name="T170-V2.1-A0"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_ros2_control" default="true"/>
  <xacro:arg name="use_gazebo" default="true"/>
  <xacro:arg name="use_dexterous_hand" default="false"/>
  <!--
    Arm kinematic zero:
      pose:=t → T-pose (default; mechanical zero)
      pose:=q → Q-pose (Unitree zero = commit 10666da overlay in pose/q_pose.xacro)
    See urdf/pose/README.md
  -->
  <xacro:arg name="pose" default="t"/>
  <xacro:property name="pose_name" value="$(arg pose)"/>

  <!-- Load T defaults, then optionally overlay Q (10666da). -->
  <xacro:include filename="pose/t_pose.xacro"/>
  <xacro:include filename="pose/q_pose.xacro"/>
  <xacro:ti5_load_t_pose/>
  <xacro:if value="${pose_name == 'q'}">
    <xacro:ti5_load_q_pose/>
  </xacro:if>

  <xacro:property
    name="mesh_dir"
    value="package://ti5_t170_description/meshes"/>
  <!-- 碰撞用的凸包：scripts/make_hulls.py 由 meshes/*.STL 產生，檔名、座標與單位都和原檔相同 -->
  <xacro:property
    name="hull_dir"
    value="${mesh_dir}/hulls"/>

  <!-- Gazebo 時使用簡化碰撞（box）以提升 RTF；非 Gazebo 時保留 mesh 碰撞 -->
  <!-- origin_* 只套用在 box（origin_z 設負值讓 box 下移，腳掌 link 用來對齊腳底與地面）；
       mesh 本身就在 link 座標系，套用偏移會讓碰撞（以及由 URDF 轉出的模型）與外觀錯開 -->
  <xacro:macro name="collision_geometry" params="mesh_file size_x:=0.12 size_y:=0.12 size_z:=0.2 origin_x:=0 origin_y:=0 origin_z:=0">
    <collision>
      <xacro:if value="$(arg use_gazebo)">
        <origin xyz="${origin_x} ${origin_y} ${origin_z}" rpy="0 0 0" />
        <geometry>
          <box size="${size_x} ${size_y} ${size_z}" />
        </geometry>
      </xacro:if>
      <xacro:unless value="$(arg use_gazebo)">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_file}" />
        </geometry>
      </xacro:unless>
    </collision>
  </xacro:macro>

  <link name="base_link"/>
  <joint name="base_link_to_base_s" type="fixed">
    <parent link="base_link"/>
    <child link="BASE_S"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link
    name="BASE_S">
