<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ti5_170a_graphen">

  <!-- 本體硬體：mock（mock_components/GenericSystem）、mujoco（MuJoCo 位置致動器）、
       mujoco_pd（MuJoCo 力矩致動器，配合 graphen_control/PdController）、real（ti5_hardware/Ti5Hardware，CAN 實機，位置模式）、
       real_pd（Ti5Hardware 電流模式，配合 PdController） -->
  <xacro:arg name="hardware" default="mock"/>
  <xacro:arg name="initial_positions_file" default="$(find ti5_170a_graphen)/config/initial_positions.yaml"/>
  <!-- 實機本體參數（hardware:=real / real_pd 時必填，由 bringup launch 傳入） -->
  <xacro:arg name="can_config_path" default=""/>
  <xacro:arg name="real_initial_positions_file" default=""/>
  <xacro:arg name="hw_read_timeout_ms" default="20"/>
  <!-- 送往馬達的指令最大變化速度（rad/s），開機走向 real_initial_positions 時也受限；應 >= planner 的速度 -->
  <xacro:arg name="max_command_velocity" default="0.5"/>
  <!-- hardware:=real_pd：容許連續回饋缺漏的週期數，超過就退回位置保持 -->
  <xacro:arg name="max_missed_cycles" default="2"/>

  <!-- MuJoCo 模擬（hardware:=mujoco / mujoco_pd）：本體與 IMU 都由 graphen_mujoco/MujocoSystem 提供 -->
  <xacro:arg name="mujoco_model" default=""/>
  <xacro:arg name="mujoco_viewer_port" default="0"/>
  <!-- MujocoSystem 的 fixed_base（吊掛）與 missing_joints（error / virtual） -->
  <xacro:arg name="mujoco_fixed_base" default="false"/>
  <xacro:arg name="mujoco_missing_joints" default="error"/>
  <!-- 浮動基座的初始高度（m），依模型而定（腳底貼地），由 bringup 依 robot 帶入 -->
  <xacro:arg name="mujoco_initial_base_height" default="1.07"/>

  <!-- 靈巧手：預設不啟用；啟用時 hardware:=real / real_pd 才用實機，其他都是 mock -->
  <xacro:arg name="use_hands" default="false"/>
  <xacro:arg name="left_hand_port" default="/dev/ttyUSB1"/>
  <xacro:arg name="right_hand_port" default="/dev/ttyUSB0"/>
  <xacro:arg name="hand_baudrate" default="115200"/>

  <!-- IMU（hardware:=mock / real / real_pd 時）：use_mock_imu:=true 時使用 mock IMU（與實機同名的 imu_sensor/* 介面，
       可用 topic 寫入模擬值），false 時使用實機 FSS-IMU16460-C（imu16460_hardware）。MuJoCo 時由 MujocoSystem 提供 -->
  <xacro:arg name="use_mock_imu" default="true"/>
  <xacro:arg name="imu_port" default="/dev/ttyTHS1"/>
  <xacro:arg name="imu_baudrate" default="921600"/>
  <!-- IMU 相對 base_link 的安裝位置 -->
  <!-- TODO(verify-on-hw): T170 上的 IMU 實際安裝位置與姿態 -->
  <xacro:arg name="imu_xyz" default="0 0 0.1"/>
  <xacro:arg name="imu_rpy" default="0 0 0"/>

  <!-- 本體模型，與 bringup 的 robot:= 相同（MJCF 與 PD 增益也依它選擇）：
       ti5_t170：ti5_t170_description 的 T170-V2.1-A0（與 ti5_t170 MJCF 同一份 CAD）+ dexterous_hand_description 的雙手
       ti5_170a：本套件的 robot.urdf.xacro（含雙手；MJCF 由 scripts/make_mjcf.py 從它產生）
       fb70：沒有自己的 URDF，同樣使用本套件的 robot.urdf.xacro
       aiterone_ny：graphen_aiterone_ny_description（運動學同本套件、質量取自 ti5_t170、L 型手腕轉接板與手部掛載位置不同，
                    含雙手；MJCF 由該套件的 scripts/make_mjcf.py 產生）
       四者的 32 個本體 joint 名稱相同，ros2_control 區塊共用。
       TODO(verify-on-hw): ti5_t170 與本套件的本體有 6 軸軸向相反（L/R_WRIST_R、L/R_WRIST_Y、NECK_P、R_SHOULDER_Y），
       位置極限也不同（HIP_P ±3.14、KNEE_P、WRIST_R）。Ti5Hardware 以 URDF 的極限做安全限制，
       實機上線前要逐軸確認馬達方向與極限 -->
  <xacro:arg name="robot" default="ti5_170a"/>
  <xacro:property name="robot_model" value="$(arg robot)"/>
  <xacro:if value="${robot_model not in ['ti5_t170', 'ti5_170a', 'fb70', 'aiterone_ny']}">
    ${xacro.fatal("robot must be one of ti5_t170, ti5_170a, fb70, aiterone_ny; got '" + robot_model + "'")}
  </xacro:if>

  <!-- 1. 機器人本體（root 為 base_link，含雙手模型） -->
  <xacro:if value="${robot_model == 'ti5_t170'}">
    <!-- T170-V2.1-A0.urdf.xacro 的 arg 預設會開啟 Gazebo 與它自己的 ros2_control；先宣告的 arg 預設優先，
         所以在 include 之前關閉（ros2_control 由下方的 graphen 區塊提供）。pose 為機械零點（T-pose），與 MJCF 相同 -->
    <xacro:arg name="use_ros2_control" default="false"/>
    <xacro:arg name="use_gazebo" default="false"/>
    <xacro:arg name="pose" default="t"/>
    <xacro:include filename="$(find ti5_t170_description)/urdf/T170-V2.1-A0.urdf.xacro"/>
    <!-- 雙手掛載位置沿用 ti5_t170_description/urdf/ti5_with_dexterous_hand_real.urdf.xacro -->
    <xacro:include filename="$(find dexterous_hand_description)/urdf/right_hand.xacro"/>
    <xacro:include filename="$(find dexterous_hand_description)/urdf/left_hand.xacro"/>
    <xacro:right_hand parent="R_WRIST_R_S" xyz="-0.0065 -0.086 0.00" rpy="0 -1.5708 1.5708"/>
    <xacro:left_hand parent="L_WRIST_R_S" xyz="-0.0065 0.086 -0.00" rpy="0 1.5708 1.5708"/>
  </xacro:if>
  <xacro:if value="${robot_model in ['ti5_170a', 'fb70']}">
    <xacro:include filename="$(find ti5_170a_graphen)/urdf/robot.urdf.xacro"/>
  </xacro:if>
  <xacro:if value="${robot_model == 'aiterone_ny'}">
    <!-- 只取運動學模型（本體 + 雙手）；該套件的 xacro arg（prefix、hand_mount_*）使用它的預設值 -->
    <xacro:include filename="$(find graphen_aiterone_ny_description)/urdf/graphen_aiterone_ny.urdf.xacro"/>
  </xacro:if>

  <link name="imu_link"/>

  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="$(arg imu_xyz)" rpy="$(arg imu_rpy)"/>
  </joint>

  <!-- 2. 本體 ros2_control -->
  <xacro:include filename="$(find ti5_170a_graphen)/urdf/ti5_170a_graphen.ros2_control.xacro"/>
  <xacro:ti5_170a_graphen_ros2_control
    name="UpperBody"
    initial_positions_file="$(arg initial_positions_file)"
    hardware="$(arg hardware)"
    can_config_path="$(arg can_config_path)"
    real_initial_positions_file="$(arg real_initial_positions_file)"
    hw_read_timeout_ms="$(arg hw_read_timeout_ms)"
    max_command_velocity="$(arg max_command_velocity)"
    max_missed_cycles="$(arg max_missed_cycles)"
    mujoco_model="$(arg mujoco_model)"
    mujoco_viewer_port="$(arg mujoco_viewer_port)"
    mujoco_fixed_base="$(arg mujoco_fixed_base)"
    mujoco_missing_joints="$(arg mujoco_missing_joints)"
    mujoco_initial_base_height="$(arg mujoco_initial_base_height)"/>

  <!-- 3. 靈巧手 ros2_control（只在 use_hands:=true 時存在） -->
  <xacro:if value="$(arg use_hands)">
    <xacro:include filename="$(find dexterous_hand_description)/urdf/ros2_control.xacro"/>
    <xacro:right_hand_ros2_control use_fake_hardware="${'$(arg hardware)' not in ['real', 'real_pd']}"
                                   serial_port="$(arg right_hand_port)" baudrate="$(arg hand_baudrate)"/>
    <xacro:left_hand_ros2_control use_fake_hardware="${'$(arg hardware)' not in ['real', 'real_pd']}"
                                  serial_port="$(arg left_hand_port)" baudrate="$(arg hand_baudrate)"/>
  </xacro:if>

  <!-- 4. IMU -->
  <!-- 模擬 IMU：介面名稱與實機的 imu16460 xacro 相同，controller 設定在 mock 與實機下不需要更動。
       獨立成一個 mock system，讓本體改用實機時 mock IMU 仍可單獨使用。
       初始值為靜止水平：單位四元數，z 軸加速度 9.81（靜止時加速度計量到的值） -->
  <!-- MuJoCo 模擬時 IMU 由 MujocoSystem 提供，兩者都不建立 -->
  <xacro:unless value="${'$(arg hardware)'.startswith('mujoco')}">
  <xacro:if value="$(arg use_mock_imu)">
    <ros2_control name="MockImu" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
        <!-- 為 sensor 產生同名 command interface，可用 topic 寫入模擬資料 -->
        <param name="mock_sensor_commands">true</param>
      </hardware>
      <sensor name="imu_sensor">
        <state_interface name="orientation.x"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="orientation.y"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="orientation.z"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="orientation.w"><param name="initial_value">1.0</param></state_interface>
        <state_interface name="angular_velocity.x"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="angular_velocity.y"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="angular_velocity.z"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="linear_acceleration.x"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="linear_acceleration.y"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="linear_acceleration.z"><param name="initial_value">9.81</param></state_interface>
        <state_interface name="temperature"><param name="initial_value">25.0</param></state_interface>
      </sensor>
    </ros2_control>
  </xacro:if>

  <!-- 實機 IMU：獨立的 sensor 硬體元件，與本體由同一個 controller_manager 管理 -->
  <xacro:unless value="$(arg use_mock_imu)">
    <xacro:include filename="$(find imu16460_hardware)/urdf/imu16460.ros2_control.xacro"/>
    <xacro:imu16460_ros2_control name="imu16460" sensor_name="imu_sensor"
                                 port="$(arg imu_port)" baudrate="$(arg imu_baudrate)"/>
  </xacro:unless>
  </xacro:unless>

</robot>
