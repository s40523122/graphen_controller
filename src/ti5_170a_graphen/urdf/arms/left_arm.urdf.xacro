<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="t170_left_arm" params="prefix mesh_dir parent">

    <!-- ===== L_SHOULDER_P ===== -->
    <link name="${prefix}L_SHOULDER_P_S">
      <inertial>
        <origin xyz="0.003756 0.088344 0.000207" rpy="0 0 0"/>
        <mass value="1.017231"/>
        <inertia ixx="0.002372488" ixy="3.0800e-04"  ixz="1.387e-06"
                 iyy="0.001139305" iyz="1.619e-05"   izz="0.002662688"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/L_SHOULDER_P_S.STL"/></geometry>
        <material name="t170_light_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/L_SHOULDER_P_S.STL"/></geometry>
      </collision>
    </link>

    <joint name="${prefix}L_SHOULDER_P" type="revolute">
      <origin xyz="0.0005 0.0896 0.336" rpy="0 0 0"/>
      <parent link="${parent}"/>
      <child  link="${prefix}L_SHOULDER_P_S"/>
      <axis xyz="0 1 0"/>
      <limit lower="-3.14" upper="3.14" effort="63" velocity="8.06"/>
    </joint>

    <!-- ===== L_SHOULDER_R ===== -->
    <link name="${prefix}L_SHOULDER_R_S">
      <inertial>
        <origin xyz="-0.002242 0.163933 0.013931" rpy="0 0 0"/>
        <mass value="1.09809"/>
        <inertia ixx="0.004355660" ixy="-1.4642e-04" ixz="-2.079e-05"
                 iyy="0.001024988" iyz="-1.5515e-04"  izz="0.004159563"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/L_SHOULDER_R_S.STL"/></geometry>
        <material name="t170_light_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/L_SHOULDER_R_S.STL"/></geometry>
      </collision>
    </link>

    <joint name="${prefix}L_SHOULDER_R" type="revolute">
      <origin xyz="0 0.1004 0" rpy="0 0 0"/>
      <parent link="${prefix}L_SHOULDER_P_S"/>
      <child  link="${prefix}L_SHOULDER_R_S"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.57" upper="1.57" effort="63" velocity="8.06"/>
    </joint>

    <!-- ===== L_SHOULDER_Y ===== -->
    <link name="${prefix}L_SHOULDER_Y_S">
      <inertial>
        <origin xyz="-0.000772 0.079344 0.003345" rpy="0 0 0"/>
        <mass value="0.71509"/>
        <inertia ixx="0.001531929" ixy="-2.9833e-05" ixz="-1.602e-06"
                 iyy="0.000837994" iyz="1.1719e-04"   izz="0.001338292"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/L_SHOULDER_Y_S.STL"/></geometry>
        <material name="t170_light_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/L_SHOULDER_Y_S.STL"/></geometry>
