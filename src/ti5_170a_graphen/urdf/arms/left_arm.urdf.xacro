    <!-- ===== L_WRIST_R ===== -->
    <link name="${prefix}L_WRIST_R_S">
      <inertial>
        <origin xyz="0.01174 -0.094004 0.0" rpy="0 0 0"/>
        <mass value="1.439466"/>
        <inertia ixx="0.001896496" ixy="9.3599e-05" ixz="-5.630e-10"
                 iyy="0.001552196" iyz="1.350e-09"   izz="0.001933785"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/L_WRIST_R_S.STL"/></geometry>
        <material name="t170_white"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/L_WRIST_R_S.STL"/></geometry>
      </collision>
    </link>

    <joint name="${prefix}L_WRIST_R" type="revolute">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}L_WRIST_Y_S"/>
      <child  link="${prefix}L_WRIST_R_S"/>
      <axis xyz="1 0 0"/>
      <limit lower="-2.35" upper="0.348" effort="8.3" velocity="12.36"/>
    </joint>

  </xacro:macro>

</robot>
