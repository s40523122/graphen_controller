      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="${mesh_dir}/old_head/NECK_R_S.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="${prefix}NECK_R"
    type="revolute">
    <origin
      xyz="0 0 0"
      rpy="1.5708 0 0" />
    <parent
      link="${prefix}NECK_P_S" />
    <child
      link="${prefix}NECK_R_S" />
    <axis
      xyz="1 0 0" />
    <limit
      lower="-0.7854"
      upper="0.7854"
      effort="2.3"
      velocity="90" />
  </joint>
  <link
    name="${prefix}NECK_CAMERA_S">
    <inertial>
      <origin
        xyz="-0.023357 -0.03695 -7.7656E-05"
        rpy="0 0 0" />
      <mass
        value="0.30970111" />
      <inertia
        ixx="0.00029399"
        ixy="3.5175E-05"
        ixz="2.7948E-05"
        iyy="0.00032475"
        iyz="-2.2326E-05"
        izz="0.0002443" />
    </inertial>
    <visual>
