      </geometry>
    </collision>
  </link>
  <joint
    name="${prefix}NECK_CAMERA"
    type="fixed">
    <origin
      xyz="0.056875 0.10712 0"
      rpy="0 0 -0.17453" />
    <parent
      link="${prefix}NECK_R_S" />
    <child
      link="${prefix}NECK_CAMERA_S" />
    <axis
