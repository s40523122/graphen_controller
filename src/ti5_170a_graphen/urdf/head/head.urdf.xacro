    <joint
    name="${prefix}NECK_Y"
    type="revolute">
    <origin
      xyz="0.0005 0 0.336"
      rpy="0 0 0" />
    <parent
      link="${parent}" />
    <child
      link="${prefix}NECK_Y1" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-3.14"
      upper="3.14"
      effort="8.3"
      velocity="12.36" />
  </joint>
  <link
    name="${prefix}NECK_Y1">
    <inertial>
      <origin
        xyz="8.3048E-05 -0.016082 0.058359"
        rpy="0 0 0" />
      <mass
        value="0.41567813" />
      <inertia
        ixx="0.00040539"
        ixy="2.219E-07"
        ixz="-2.9368E-09"
        iyy="0.00022035"
        iyz="9.095E-05"
        izz="0.00024863" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="${mesh_dir}/old_head/NECK_Y1.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.89804 0.91765 0.92941 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="${mesh_dir}/old_head/NECK_Y1.STL" />
      </geometry>
    </collision>
  </link>
  <link
    name="${prefix}NECK_P_S">
    <inertial>
      <origin
        xyz="0.00040928 -0.0012918 -3.4508E-05"
        rpy="0 0 0" />
      <mass
        value="0.25030706" />
      <inertia
        ixx="9.727E-06"
        ixy="3.1503E-06"
        ixz="2.0046E-06"
        iyy="9.6845E-06"
        iyz="1.4836E-08"
        izz="1.1224E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
