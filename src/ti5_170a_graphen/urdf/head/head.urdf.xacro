      </geometry>
    </collision>
  </link>
  <joint
    name="${prefix}NECK_P"
    type="revolute">
    <origin
      xyz="0 0 0.12"
      rpy="0 0 0" />
    <parent
      link="${prefix}NECK_Y1" />
    <child
      link="${prefix}NECK_P_S" />
    <axis
      xyz="0 -1 0" />
    <limit
      lower="-0.6807"
      upper="0.6807"
      effort="2.3"
      velocity="90" />
  </joint>
  <link
    name="${prefix}NECK_R_S">
    <inertial>
      <origin
        xyz="0.0098842 0.055042 3.7167E-05"
        rpy="0 0 0" />
      <mass
