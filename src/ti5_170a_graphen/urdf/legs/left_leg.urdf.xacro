<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="t170_left_leg" params="prefix mesh_dir parent">

    <!-- ===== L_HIP_P ===== -->
    <link name="${prefix}L_HIP_P_S">
      <inertial>
        <origin xyz="0.0055060000000000005 0.001116 -0.135556" rpy="0 0 0"/>
        <mass value="2.123182"/>
        <inertia
                ixx="0.007651730159"
                ixy="-1.0006102999999999e-05"
                ixz="-0.001027271998"
                iyy="0.008350014866"
                iyz="-0.00015041607399999998"
                izz="0.003346951658" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/L_HIP_P_S.STL"/></geometry>
        <material name="t170_light_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/L_HIP_P_S.STL"/></geometry>
      </collision>
    </link>

    <joint name="${prefix}L_HIP_P" type="revolute">
      <origin xyz="0 0.0545 0" rpy="0 0 0"/>
      <parent link="${parent}"/>
      <child  link="${prefix}L_HIP_P_S"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="267" velocity="5.76"/>
    </joint>

    <!-- ===== L_HIP_R ===== -->
