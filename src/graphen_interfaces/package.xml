<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>graphen_interfaces</name>
  <version>0.0.0</version>
  <description>Graphen ROS 2 interface definitions: playback actions (SwitchMode, PlayChoreo, PlayBvh, RunPolicy) with their shared Playback* messages, and the choreography library / preload services.</description>
  <maintainer email="riverji@graphen.ai">jin</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>action_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
