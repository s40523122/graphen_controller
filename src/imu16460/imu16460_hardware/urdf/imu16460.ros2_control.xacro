<?xml version="1.0"?>
<!-- FSS-IMU16460-C 實機的 ros2_control 描述。
     匯出 imu_sensor_broadcaster 需要的 10 個 state interface，以及 temperature（broadcaster 會忽略）。
     參數說明見 imu16460_hardware/README.md -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="imu16460_ros2_control"
               params="name:=imu16460 sensor_name:=imu_sensor
                       port:=/dev/ttyTHS1 baudrate:=921600
                       data_timeout_ms:=100 error_on_timeout:=false activate_timeout_ms:=1000
                       axis_transform:=none euler_order:=zyx">
    <ros2_control name="${name}" type="sensor">
      <hardware>
        <plugin>imu16460_hardware/Imu16460SensorInterface</plugin>
        <param name="port">${port}</param>
        <param name="baudrate">${baudrate}</param>
        <param name="data_timeout_ms">${data_timeout_ms}</param>
        <param name="error_on_timeout">${error_on_timeout}</param>
        <param name="activate_timeout_ms">${activate_timeout_ms}</param>
        <param name="axis_transform">${axis_transform}</param>
        <param name="euler_order">${euler_order}</param>
      </hardware>
      <sensor name="${sensor_name}">
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
        <state_interface name="temperature"/>
      </sensor>
    </ros2_control>
  </xacro:macro>

</robot>
