<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>graphen_controllers</name>
  <version>0.0.0</version>
  <description>Graphen ros2_control controller plugins (SwitchGroupController, PositionController, PdController).</description>
  <maintainer email="riverji@graphen.ai">jin</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>controller_interface</depend>
  <depend>geometry_msgs</depend>
  <depend>graphen_control_utils</depend>
  <depend>graphen_interfaces</depend>
  <depend>graphen_locomotion</depend>
  <depend>graphen_motion</depend>
  <depend>hardware_interface</depend>
  <depend>lifecycle_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>
  <depend>std_msgs</depend>
  <depend>yaml-cpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- 告知 controller_manager 本套件提供可動態載入的 Controller Plugin -->
    <controller_interface plugin="${prefix}/graphen_controllers.xml"/>
  </export>
</package>
